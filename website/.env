# Server Configuration
PORT=3000
NODE_ENV=development
WEBSITE_URL=http://localhost:3000

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-actual-email@gmail.com
SMTP_PASS=your-app-password
CONTACT_EMAIL=contact@theobviouscompany.com
SALES_EMAIL=sales@theobviouscompany.com
SUPPORT_EMAIL=support@theobviouscompany.com
ESCALATION_EMAIL=tech@theobviouscompany.com
FEEDBACK_EMAIL=feedback@theobviouscompany.com

# Security Configuration
SESSION_SECRET=dev-session-secret-key-change-in-production
JWT_SECRET=dev-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=1h
ENCRYPTION_KEY=dev-encryption-key-change-in-production
BCRYPT_ROUNDS=10
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900

# Database Configuration (Development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=assessment_platform_dev
DB_USER=postgres
DB_PASSWORD=dev-password
DB_SSL=false
DB_MAX_CONNECTIONS=10

# Redis Configuration (Development)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dev-redis-password
REDIS_DB=0

# Launch Configuration
LAUNCH_PHASE=beta
ROLLOUT_STRATEGY=gradual
LAUNCH_TIMESTAMP=2025-01-08T12:00:00Z

# Feature Flags
MONITORING_ENABLED=true
FEEDBACK_ENABLED=true
SUPPORT_ENABLED=true

# Launch Monitoring
LAUNCH_WEBHOOK_URL=
ADMIN_KEY=dev-admin-key-12345

# Performance Thresholds
RESPONSE_TIME_THRESHOLD=2000
ERROR_RATE_THRESHOLD=0.05
MEMORY_THRESHOLD=0.85

# Integration Secrets
WEBHOOK_SECRET=dev-webhook-secret-key
CALENDAR_WEBHOOK_SECRET=dev-calendar-webhook-secret
UNSUBSCRIBE_SECRET=dev-unsubscribe-secret-key

# Privacy & Compliance (Development)
DATA_RETENTION_DAYS=30
ANONYMIZATION_DELAY=1
CONSENT_VALIDITY_DAYS=365
GDPR_ENABLED=true
CCPA_ENABLED=false

# Audit & Compliance (Development)
ENABLE_REAL_TIME_AUDITING=false
AUDIT_RETENTION_DAYS=30
COMPLIANCE_REPORTING_INTERVAL=24

# Development Settings
DEBUG=true
LOG_LEVEL=debug